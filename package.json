{
  "name": "@dsh-plugin/idle-scholar",
  "version": "0.3.0",
  "private": true,
  "description": "Idle-time micro-learning for DeepSeek Harness: turns the agent's waiting gaps into flash cards. Ships seed decks for English, Japanese, and the eight subjects of the Chinese National Judicial Examination (法考), and accepts community course packs as plain JSON.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "learning",
    "flashcards",
    "english",
    "japanese",
    "faka",
    "judicial-exam",
    "agent-skill"
  ],
  "author": "light",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smallballoons01/dsh-idle-scholar.git"
  },
  "homepage": "https://github.com/Smallballoons01/dsh-idle-scholar#readme",
  "bugs": {
    "url": "https://github.com/Smallballoons01/dsh-idle-scholar/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./courses": "./courses.js",
    "./progress": "./progress.js",
    "./skill": "./skill.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "skill.js",
    "courses.js",
    "progress.js",
    "cordis.patch.yml",
    "courses/",
    "skills/",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test",
    "skill": "node scripts/generate-skill.mjs",
    "skill:check": "node scripts/generate-skill.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "*"
  }
}
